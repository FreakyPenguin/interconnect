+    /// Customize cached shaping before layout, invalidating any previous layout.
+    ///
+    /// Embedded-object callers must reapply custom metrics after changing text,
+    /// attributes or fonts. Ordinary shaping remains unchanged.
+    pub fn customize_shape(
+        &mut self,
+        font_system: &mut FontSystem,
+        tab_width: u16,
+        customize: impl FnOnce(&mut ShapeLine),
+    ) {
+        self.shape(font_system, tab_width);
+        self.layout_opt.set_unused();
+        customize(self.shape_opt.get_mut().expect("shape initialized above"));
+    }
