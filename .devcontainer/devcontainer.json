{
  "name": "Matrix client — Rust",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "vadimcn.vscode-lldb", "tamasfe.even-better-toml"],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "postCreateCommand": "rustc --version && cargo --version && cargo fmt --version && cargo clippy --version",
  "mounts": [
    "source=verifynet-codex,target=/home/vscode/.codex,type=volume",
    "source=${localEnv:XDG_RUNTIME_DIR}/bus,target=/tmp/host-session-bus,type=bind"
  ],
  "containerEnv": {
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/host-session-bus",
    "NODEVICE_SELECT": "1"
  },
  "runArgs": [
    "--device=/dev/dri:/dev/dri",
    "--group-add=106",
    "--group-add=44"
  ]
}
